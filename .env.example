# Local development settings. Copy to .env (never commit .env). See docs/SETUP_AND_DEPLOY.md.
PIM_ENV=local
PIM_DATABASE_URL=postgresql+psycopg://pim@localhost:5432/pim
PIM_DEV_USER_EMAIL=dchristy@swimusa.com
PIM_DEV_USER_ROLES=pim_admin
PIM_ROLE_SOURCE=table
PIM_STYLE_MASTER_TABLE=swim_data_whse.bluecherry.style_master
PIM_IMPORT_VOLUME=./local_data/imports
PIM_PACKAGE_VOLUME=./local_data/packages
PIM_FEATURE_SHOPIFY_DIRECT_WRITE=false
# Optional, only needed when calling Databricks from a laptop:
# DATABRICKS_HOST=https://adb-xxxx.azuredatabricks.net
# DATABRICKS_TOKEN=...
# PIM_SQL_WAREHOUSE_ID=...
# PIM_AIR_API_KEY=...
# PIM_AIR_WORKSPACE_ID=...
# PIM_SHOPIFY_STORE_DOMAIN=vitamin-a.myshopify.com
# PIM_SHOPIFY_READ_TOKEN=...
